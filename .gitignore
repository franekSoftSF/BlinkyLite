# Build
bin/
obj/
out/
*.user
*.suo
.vs/
.idea/
TestResults/
*.trx

# Local config and secrets
.env
# Docker secrets and the TLS key of a stack: the KEK in here is the only thing
# standing between a database dump and every PUK in it.
secrets/
certs/
appsettings.*.local.json
*.pfx
*.p12
*.key
certs/

# Runtime data. Rooted: on Windows git ignores case, and a bare data/
# also swallowed src/BlinkyLite.Server/Data - the whole database layer.
/data/
*.log

# APDU transcripts carry the token serial and certificates
transcripts/

# Build output: installers and published binaries
artifacts/

# Worktrees for parallel work
.worktrees/

# brand/build-assets.mjs installs sharp only for itself (see the script).
brand/node_modules/
brand/package.json
brand/package-lock.json
