{
  // A template, not a live file. Copy what you need into appsettings.json
  // (Windows: %ProgramData%\BlinkyLite\appsettings.json) or set the same keys
  // as environment variables: BLINKYLITE__ is not used, the keys are plain,
  // e.g. Jwt__SigningKey, ConnectionStrings__App, Roles__Admin__0.
  //
  // Nothing secret belongs in git. The signing key, the KEKs and the two
  // passwords come from environment variables, Docker secrets, or a
  // DPAPI-protected file on Windows.

  "ConnectionStrings": {
    // The server's own role: SELECT and EXECUTE on bl_* only (docs/07).
    "App": "Host=db;Database=blinkylite;Username=blinkylite_app;Password=...",
    // Used only by --migrate, and only by a person or a deployment step.
    "Owner": "Host=db;Database=blinkylite;Username=blinkylite_owner;Password=..."
  },

  // TLS is not optional outside development: the operator's AD password and
  // the JWT travel on this connection. The server refuses to start without an
  // HTTPS endpoint (exit code 4).
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:8443",
        "Certificate": {
          // Docker: a mounted file. Windows: use "Subject" and "Store" instead
          // to read the certificate from LocalMachine\My.
          "Path": "/certs/blinkylite.pfx",
          "Password": "..."
        }
      }
    }
  },

  "Jwt": {
    // 32+ random bytes, base64. Changing it signs everyone out, which is the
    // fastest way to end a session that should not continue.
    "SigningKey": "base64-32-bytes",
    "LifetimeMinutes": 30
  },

  "Ldap": {
    "Server": "dc01.corp.example",
    "Port": 636,
    // Ldaps or StartTls. There is no plain option.
    "Transport": "Ldaps",
    "BaseDn": "DC=corp,DC=example",
    // The NetBIOS name: the CA needs DOMAIN\user in RequesterName.
    "NetBiosDomain": "CORP",
    // Read-only, used for searching people. Never for signing anybody in.
    "ServiceAccount": "CORP\\svc-blinkylite",
    "ServicePassword": "...",
    "TimeoutSeconds": 10
  },

  // AD groups by SID, never by name: renaming a group must not grant or remove
  // a role. Admin and SecurityOfficer must be the groups that hold Enrollment
  // Agent rights on the CA (D-17) - what BlinkyLite allows and what the CA
  // allows are then the same list, kept in one place.
  "Roles": {
    "Admin": [ "S-1-5-21-...-1100" ],
    "SecurityOfficer": [ "S-1-5-21-...-1101" ],
    "Helpdesk": [ "S-1-5-21-...-1102" ]
  },

  "Secrets": {
    // Version used to seal new envelopes; old versions stay readable.
    "CurrentKekVersion": 1,
    "Keks": {
      "1": "base64-32-bytes"
    }
  },

  "RateLimits": {
    "LoginPerMinute": 10
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "NHibernate": "Warning"
      }
    }
  }
}
