{
  // A template, not a live file. Copy what you need into appsettings.json
  // (Windows: %ProgramData%\BlinkyLite\appsettings.json) or set the same keys
  // as environment variables, e.g. ConnectionStrings__App, Roles__Admin__0.
  //
  // NO SECRET BELONGS IN THIS FILE (D-18). The server refuses to start outside
  // development when it finds one here: the JWT signing key, a KEK, the LDAP
  // service password or a password inside a connection string. Secrets come
  // from files or environment variables - see "Secrets" below.

  "ConnectionStrings": {
    // Without the password: the server adds it from the secret db-app-password.
    "App": "Host=db;Database=blinkylite;Username=blinkylite_app",
    // Used only by --migrate; password from db-owner-password.
    "Owner": "Host=db;Database=blinkylite;Username=blinkylite_owner"
  },

  // Where the secrets are. One file per secret, named blinkylite-<name>, or
  // blinkylite-<name>.dpapi on Windows (protected with the machine key).
  // Names: jwt-signing-key, ldap-service-password, db-app-password,
  // db-owner-password, kek-<version>.
  // Last resort: the environment variable BLINKYLITE_SECRET_<NAME>.
  //
  //   Docker:  a Docker secret mounted at /run/secrets (the default)
  //   Windows: echo <value> | BlinkyLite.Server.exe --protect-secret kek-1
  "Secrets": {
    "Directory": "C:\\ProgramData\\BlinkyLite\\secrets",
    // Optional: a single secret somewhere else.
    "Files": {
      // "kek-1": "D:\\keys\\blinkylite-kek-1.dpapi"
    },
    // Version used to seal new envelopes; older ones stay readable as long as
    // their KEK is still in place.
    "CurrentKekVersion": 1,
    // Versions to load besides the current one, after a rotation.
    "KekVersions": [ 1 ]
  },

  // TLS is not optional outside development: the operator's AD password and
  // the JWT travel on this connection. The server refuses to start without an
  // HTTPS endpoint (exit code 4).
  "Kestrel": {
    "Endpoints": {
      "Https": {
        "Url": "https://*:8443",
        "Certificate": {
          // Docker: a mounted file. Windows: use "Subject" and "Store" instead
          // to read the certificate from LocalMachine\My.
          "Path": "/certs/blinkylite.pfx"
        }
      }
    }
  },

  "Jwt": {
    // The key itself is the secret jwt-signing-key: 32+ random bytes, base64.
    // Changing it signs everyone out, which is the fastest way to end a
    // session that should not continue.
    "LifetimeMinutes": 30
  },

  "Ldap": {
    "Server": "dc01.corp.example",
    "Port": 636,
    // Ldaps or StartTls. There is no plain option.
    "Transport": "Ldaps",
    "BaseDn": "DC=corp,DC=example",
    // The NetBIOS name: the CA needs DOMAIN\user in RequesterName.
    "NetBiosDomain": "CORP",
    // Read-only, used for searching people. Never for signing anybody in.
    // Its password is the secret ldap-service-password.
    "ServiceAccount": "CORP\\svc-blinkylite",
    "TimeoutSeconds": 10
  },

  // AD groups by SID, never by name: renaming a group must not grant or remove
  // a role. Admin and SecurityOfficer must be the groups that hold Enrollment
  // Agent rights on the CA (D-17) - what BlinkyLite allows and what the CA
  // allows are then the same list, kept in one place.
  "Roles": {
    "Admin": [ "S-1-5-21-...-1100" ],
    "SecurityOfficer": [ "S-1-5-21-...-1101" ],
    "Helpdesk": [ "S-1-5-21-...-1102" ]
  },

  "RateLimits": {
    "LoginPerMinute": 10
  },

  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "NHibernate": "Warning"
      }
    }
  }
}
