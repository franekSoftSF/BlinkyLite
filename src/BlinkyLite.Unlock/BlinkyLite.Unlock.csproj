<Project Sdk="Microsoft.NET.Sdk">

  <!-- The one thing a person whose PIN is blocked can do for themselves
       (D-36): type the PUK the helpdesk read out and set a new PIN. No server,
       because somebody with a blocked PIN cannot sign in anywhere; no issuance
       engine, because this must not be able to issue anything. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <RootNamespace>BlinkyLite.Unlock</RootNamespace>
    <AssemblyName>BlinkyLite.Unlock</AssemblyName>

    <!-- As in the client: invariant mode makes WPF throw when a text box takes
         focus, which here is the PIN box. -->
    <InvariantGlobalization>false</InvariantGlobalization>
    <ApplicationIcon>Assets\blinkylite.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\blinkylite.ico" />
    <Resource Include="Assets\blinkylite-mark-128.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlinkyLite.Contracts\BlinkyLite.Contracts.csproj" />
    <ProjectReference Include="..\BlinkyLite.Piv\BlinkyLite.Piv.csproj" />
    <ProjectReference Include="..\BlinkyLite.Ui\BlinkyLite.Ui.csproj" />
  </ItemGroup>

</Project>
