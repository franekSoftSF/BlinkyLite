<Window x:Class="BlinkyLite.Unlock.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BlinkyLite.Ui.Localisation;assembly=BlinkyLite.Ui"
        Title="{l:Loc unlock.title}"
        Icon="Assets/blinkylite.ico"
        Width="620"
        Height="820"
        MinWidth="560"
        MinHeight="600"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="14">

    <!-- One window, top to bottom, in the order the person does it: the key,
         the PUK (typed, or fetched over the telephone), the new PIN. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,0,0,1"
                Padding="20,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="ThemeButton" Style="{StaticResource Quiet}" Click="ThemeToggled" ToolTip="{l:Loc client.theme}">
                        <TextBlock Text="&#xE793;" FontFamily="{StaticResource Icons}" FontSize="16" />
                    </Button>

                    <ComboBox x:Name="LanguagePicker"
                              Width="140"
                              Margin="8,0,0,0"
                              DisplayMemberPath="Name"
                              SelectionChanged="LanguageChanged"
                              ToolTip="{l:Loc common.language}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="Assets/blinkylite-mark-128.png" Width="40" Height="40" Margin="0,0,12,0"
                           VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="20" FontWeight="Bold">
                            <Run Text="Blinky" /><Run Text="Lite" Foreground="{DynamicResource AccentText}" />
                        </TextBlock>
                        <TextBlock Text="{l:Loc unlock.title}" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Card}" Margin="20" Padding="28,24">
                <StackPanel>
                    <TextBlock Text="{l:Loc unlock.explain}" Style="{StaticResource Hint}" FontSize="13" Margin="0,0,0,20" TextWrapping="Wrap" />

                    <!-- 1. The key -->
                    <TextBlock Text="{l:Loc unlock.step.card}" Style="{StaticResource FieldLabel}" />
                    <Border Background="{DynamicResource Background}"
                            BorderBrush="{DynamicResource Border}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12,10">
                        <DockPanel>
                            <TextBlock x:Name="CardMark" DockPanel.Dock="Left" Text="&#xE8CC;" FontFamily="{StaticResource Icons}"
                                       FontSize="18" VerticalAlignment="Center" Margin="0,0,12,0"
                                       Foreground="{DynamicResource MutedText}" />
                            <TextBlock x:Name="CardText" TextWrapping="Wrap" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <Button x:Name="RefreshButton" HorizontalAlignment="Left" Margin="0,8,0,20" Click="CardRefreshed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{l:Loc client.refresh}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- 2. The PUK: typed by hand, or fetched after somebody at
                         the helpdesk approves the code. Two buttons rather than
                         tabs, because there are exactly two ways and both have
                         to be readable from across the desk. -->
                    <TextBlock Text="{l:Loc unlock.step.puk}" Style="{StaticResource FieldLabel}" />
                    <UniformGrid Columns="2" Margin="0,0,0,14">
                        <Button x:Name="PukModeButton" Click="PukModeChosen" Margin="0,0,4,0" Padding="10,10">
                            <TextBlock Text="{l:Loc unlock.mode.puk}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                        <Button x:Name="RemoteModeButton" Click="RemoteModeChosen" Margin="4,0,0,0" Padding="10,10">
                            <TextBlock Text="{l:Loc unlock.mode.remote}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                    </UniformGrid>

                    <StackPanel x:Name="PukPanel">
                        <PasswordBox x:Name="PukBox" FontSize="18" FontFamily="{StaticResource Mono}" MaxLength="8" PasswordChanged="Typed" />
                        <TextBlock Text="{l:Loc unlock.puk.hint}" Style="{StaticResource Hint}" Margin="2,6,0,20" />
                    </StackPanel>

                    <StackPanel x:Name="RemotePanel" Visibility="Collapsed" Margin="0,0,0,20">
                        <TextBlock Text="{l:Loc unlock.remote.explain}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12" />

                        <TextBlock Text="{l:Loc unlock.remote.server}" Style="{StaticResource FieldLabel}" />
                        <TextBox x:Name="ServerBox" TextChanged="Typed" />
                        <!-- Filled only when an administrator set the address
                             (0057); otherwise there is nothing to say here. -->
                        <TextBlock x:Name="ServerHint" Style="{StaticResource Hint}" Margin="2,6,0,0" TextWrapping="Wrap" />

                        <!-- The code, once there is one: big, spaced and in a
                             mono font, because it is going to be read out over
                             a telephone. -->
                        <Border x:Name="CodePanel"
                                Visibility="Collapsed"
                                Margin="0,14,0,0"
                                Background="{DynamicResource Background}"
                                BorderBrush="{DynamicResource Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="16,14">
                            <StackPanel>
                                <TextBlock Text="{l:Loc unlock.remote.code}" Style="{StaticResource Hint}" />
                                <TextBlock x:Name="CodeText"
                                           FontFamily="{StaticResource Mono}"
                                           FontSize="34"
                                           FontWeight="Bold"
                                           Margin="0,6,0,0"
                                           Foreground="{DynamicResource AccentText}" />
                                <TextBlock x:Name="ExpiryText" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                                <TextBlock x:Name="WaitingText" Margin="0,8,0,0" TextWrapping="Wrap"
                                           Foreground="{DynamicResource MutedText}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- 3. The new PIN, twice. The same two boxes whichever way
                         the PUK arrives. -->
                    <TextBlock Text="{l:Loc unlock.step.pin}" Style="{StaticResource FieldLabel}" />
                    <PasswordBox x:Name="PinBox" FontSize="18" FontFamily="{StaticResource Mono}" MaxLength="8" PasswordChanged="Typed" />

                    <TextBlock Text="{l:Loc pin.repeat}" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <PasswordBox x:Name="RepeatBox" FontSize="18" FontFamily="{StaticResource Mono}" MaxLength="8" PasswordChanged="Typed" />

                    <!-- The verdict carries a mark as well as a colour: somebody
                         at this desk may not tell red from green. -->
                    <DockPanel Margin="0,14,0,0">
                        <TextBlock x:Name="Mark" DockPanel.Dock="Left" Width="24" FontWeight="Bold"
                                   Foreground="{DynamicResource MutedText}" />
                        <TextBlock x:Name="Verdict" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
                    </DockPanel>

                    <Button x:Name="UnlockButton"
                            Style="{StaticResource Primary}"
                            FontSize="16"
                            Padding="16,12"
                            Margin="0,20,0,0"
                            IsEnabled="False"
                            IsDefault="True"
                            Click="Unlocked">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE785;" FontFamily="{StaticResource Icons}" FontSize="16" VerticalAlignment="Center"
                                       Margin="0,0,10,0" Foreground="{DynamicResource OnAccent}" />
                            <TextBlock x:Name="UnlockButtonText" VerticalAlignment="Center" Foreground="{DynamicResource OnAccent}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2"
                Background="{DynamicResource Surface}"
                BorderBrush="{DynamicResource Border}"
                BorderThickness="0,1,0,0"
                Padding="20,10">
            <StackPanel>
                <TextBlock x:Name="Message" TextWrapping="Wrap" Foreground="{DynamicResource MutedText}" />
                <TextBlock x:Name="Details" Margin="0,2,0,0" FontSize="12" TextWrapping="Wrap"
                           FontFamily="{StaticResource Mono}" Foreground="{DynamicResource MutedText}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
