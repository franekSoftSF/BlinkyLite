<Project Sdk="Microsoft.NET.Sdk">

  <!-- Brought over from Blinky.Piv in 0010 (docs/06-from-blinky.md). Plain
       net10.0 so that the server can re-verify attestation with the same code
       the workstation uses. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="BlinkyLite.UnitTests" />
    <!-- The bench tool's dump command reads raw TLV the same way this layer
         does; a second parser in the tool would disagree with this one in
         exactly the cases a dump exists to show. -->
    <InternalsVisibleTo Include="BlinkyLite.CardLab" />
  </ItemGroup>

  <ItemGroup>
    <!-- Yubico's attestation roots, pinned by fingerprint at load. Embedded so
         that a deployment cannot quietly swap the trust anchor for a file. -->
    <EmbeddedResource Include="Attestation\yubico-piv-attestation-root.pem" />
    <EmbeddedResource Include="Attestation\yubico-attestation-root-1.pem" />
    <EmbeddedResource Include="Attestation\yubico-piv-attestation-intermediates.pem" />
  </ItemGroup>

</Project>
