<Window x:Class="BlinkyLite.Client.LogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:BlinkyLite.Client.Localisation"
        Title="{l:Loc client.log.title}"
        Icon="Assets/blinkylite.ico"
        Width="980"
        Height="640"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource Background}"
        Foreground="{DynamicResource Text}"
        FontFamily="Segoe UI"
        FontSize="14">

    <DockPanel Margin="20">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
            <TextBlock Text="{l:Loc client.log.title}" FontSize="20" FontWeight="SemiBold" />
            <!-- Said on the screen, because the first question about a log is
                 what it might have in it. -->
            <TextBlock Text="{l:Loc client.log.explain}" Style="{StaticResource Hint}" FontSize="13" Margin="0,4,0,0" />
            <TextBlock x:Name="FileText" Style="{StaticResource Hint}" FontFamily="{StaticResource Mono}" Margin="0,6,0,0" />
        </StackPanel>

        <DockPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <Button DockPanel.Dock="Right" Content="{l:Loc common.close}" IsCancel="True" Margin="8,0,0,0" Click="Closed_" />

            <StackPanel Orientation="Horizontal">
                <Button Click="Refreshed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc client.refresh}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="Copied">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8C8;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc client.log.copy}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Click="FolderOpened">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE838;" FontFamily="{StaticResource Icons}" FontSize="13" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{l:Loc client.log.open-folder}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <TextBlock x:Name="Status" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </DockPanel>

        <Border Style="{StaticResource Card}" Padding="0">
            <TextBox x:Name="LogText"
                     IsReadOnly="True"
                     IsReadOnlyCaretVisible="False"
                     BorderThickness="0"
                     Background="Transparent"
                     FontFamily="{StaticResource Mono}"
                     FontSize="12"
                     Padding="12,10"
                     TextWrapping="NoWrap"
                     VerticalContentAlignment="Top"
                     HorizontalScrollBarVisibility="Auto"
                     VerticalScrollBarVisibility="Auto" />
        </Border>
    </DockPanel>
</Window>
