<Application x:Class="BlinkyLite.Client.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>

        <!-- Implicit styles, because WPF's default templates take their colours
             from the system and not from the window. In the dark theme that
             meant black text on a dark list: the first operator to look at it
             could not read a word. Every control that shows text names its
             role here, so a colour is chosen in one place and the contrast
             test still covers it (D-20). -->

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}" />
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="CaretBrush" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFill}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Padding" Value="10,6" />
            <Style.Triggers>
                <!-- A disabled button still has to be readable as a word;
                     the system's grey-on-grey is not. -->
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedText}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

        <Style TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
            <Setter Property="Padding" Value="6,4" />
            <Style.Triggers>
                <!-- Selection in the accent, with black on it: the one pairing
                     of this green that reaches 8,1:1. The system's blue
                     highlight would put its own white on top instead. -->
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFill}" />
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{DynamicResource Text}" />
        </Style>

    </Application.Resources>
</Application>
