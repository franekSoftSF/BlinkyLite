# Settings for the compose stack. Copy to .env and fill in.
# NO SECRETS HERE: they live in ./secrets as Docker secrets (D-18).

# Port the server listens on, on the host.
BLINKYLITE_PORT=8443

# Active Directory. LDAPS on 636, or StartTls on 389 - there is no plain
# option. A corporate CA for LDAPS goes into certs/ca/ldap-ca.crt.
BLINKYLITE_LDAP_SERVER=dc01.corp.example
BLINKYLITE_LDAP_PORT=636
BLINKYLITE_LDAP_TRANSPORT=Ldaps
BLINKYLITE_LDAP_BASE_DN=DC=corp,DC=example
# NetBIOS name: the CA needs DOMAIN\user in RequesterName.
BLINKYLITE_NETBIOS_DOMAIN=CORP
# Read-only account for searching people; its password is the secret
# secrets/blinkylite-ldap-service-password.
BLINKYLITE_LDAP_SERVICE_ACCOUNT=CORP\svc-blinkylite

# AD groups by SID, never by name: renaming a group must not grant or remove a
# role. Admin and SecurityOfficer must be the groups that hold Enrollment Agent
# rights on the CA (D-17).
#   Get-ADGroup 'BlinkyLite-Admins' | Select-Object -ExpandProperty SID
BLINKYLITE_GROUP_ADMIN=S-1-5-21-...-1100
BLINKYLITE_GROUP_SECURITY_OFFICER=S-1-5-21-...-1101
BLINKYLITE_GROUP_HELPDESK=S-1-5-21-...-1102
