<Project Sdk="Microsoft.NET.Sdk">

  <!-- net10.0-windows so that the issuance engine (CertEnroll, COM) is testable
       at all; no hardware and no database here. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- The message catalogue is tested in four languages; in invariant mode
         .NET refuses to create de-AT or pl-PL at all, so every culture test
         would fail for a reason that has nothing to do with the catalogue. -->
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- APDU captures from real tokens; the PIV tests replay them instead of
         asking for hardware. -->
    <None Include="Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlinkyLite.Contracts\BlinkyLite.Contracts.csproj" />
    <ProjectReference Include="..\..\src\BlinkyLite.Piv\BlinkyLite.Piv.csproj" />
    <ProjectReference Include="..\..\src\BlinkyLite.Issuance\BlinkyLite.Issuance.csproj" />
    <!-- For the palette alone: the colours are C# so a test can count their
         contrast, which XAML would make impossible (D-20). -->
    <ProjectReference Include="..\..\src\BlinkyLite.Client\BlinkyLite.Client.csproj" />
    <ProjectReference Include="..\..\src\BlinkyLite.Server\BlinkyLite.Server.csproj" />
  </ItemGroup>

</Project>
