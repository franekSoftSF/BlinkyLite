# Without this, COPY drops the host's bin/ and obj/ into the image on top of
# the restore that has just run there - and the build fails looking for a
# package at a Windows path that does not exist in the container.
**/bin/
**/obj/
artifacts/

.git/
.github/
.vs/
.idea/

# Never in an image: the KEK, the TLS key and the database passwords.
secrets/
certs/
.env

docs/
tests/
packaging/
*.md

# The web console is built inside the image from package-lock.json; a local
# node_modules or dist would overwrite that with whatever this machine has -
# the same mistake Windows obj/ folders once made for the server image.
web/node_modules
web/dist
web/.angular
web/public/i18n
