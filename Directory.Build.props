<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <!-- Right for the server container; WPF and the PowerShell module turn it
         off again, because WPF crashes the moment a text box takes focus under
         invariant mode (found in Blinky.Agent.Ui, in the PIN box). -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Product>BlinkyLite</Product>
    <Company>BlinkyLite contributors</Company>
    <Copyright>Copyright 2026 Szymon Frankiewicz</Copyright>
    <!-- Apache-2.0, like Blinky, from which src/BlinkyLite.Piv comes (D-34). -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/franekSoftSF/BlinkyLite</PackageProjectUrl>
    <Version>0.1.0</Version>
  </PropertyGroup>

</Project>
