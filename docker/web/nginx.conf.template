# BlinkyLite front door (0055, D-26, D-32).
#
# Port 443, the SAME certificate the server has - an operator's browser, the
# WPF client and the PowerShell module all see one name and one certificate.
# The server itself publishes no port: nginx is the only way in.
#
# ${BLINKYLITE_SERVER_NAME} is filled in by the nginx image from the
# environment when the container starts.

server {
    listen 443 ssl;
    http2 on;
    server_name ${BLINKYLITE_SERVER_NAME};

    ssl_certificate     /certs/blinkylite.crt;
    ssl_certificate_key /run/secrets/blinkylite-tls-key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:tls:10m;

    # The console shows PUKs. Nothing of it may be framed, sniffed or cached
    # by a proxy on the way.
    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass https://api:8443;
        include /etc/nginx/blinkylite-proxy.conf;
    }

    location = /health {
        proxy_pass https://api:8443;
        include /etc/nginx/blinkylite-proxy.conf;
    }

    # Translations are generated at build time and change with every release;
    # a stale one shows yesterday's words, so they are not cached for long.
    location /i18n/ {
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Angular routes: anything that is not a file is the application.
    location / {
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}

# Plain HTTP only to say where the real door is.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}
