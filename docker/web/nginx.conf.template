# BlinkyLite front door (0055, D-26, D-32).
#
# Port 443, the SAME certificate the server has - an operator's browser, the
# WPF client and the PowerShell module all see one name and one certificate.
# The server itself publishes no port: nginx is the only way in.
#
# ${BLINKYLITE_SERVER_NAME} is filled in by the nginx image from the
# environment when the container starts.

server {
    listen 443 ssl;
    http2 on;
    server_name ${BLINKYLITE_SERVER_NAME};

    ssl_certificate     /certs/blinkylite.crt;
    ssl_certificate_key /run/secrets/blinkylite-tls-key;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:tls:10m;

    # The console shows PUKs. Nothing of it may be framed, sniffed or cached
    # by a proxy on the way. Repeated in every location below that sets a
    # header of its own - see security-headers.conf for why.
    include /etc/nginx/security-headers.conf;

    root /usr/share/nginx/html;

    location /api/ {
        proxy_pass https://api:8443;
        include /etc/nginx/blinkylite-proxy.conf;
    }

    location = /health {
        proxy_pass https://api:8443;
        include /etc/nginx/blinkylite-proxy.conf;
    }

    # Translations are generated at build time and change with every release;
    # a stale one shows yesterday's words, so they are not cached for long.
    location /i18n/ {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri =404;
    }

    # Installers the console offers for download (0052): whatever
    # packaging/client/Build-Msix.ps1 put in /opt/blinkylite/downloads, with
    # the index.json the Tools page reads. Not behind a token - an installer
    # holds no secret, and a browser download cannot carry the bearer that
    # lives only in the page's memory (D-32). No listing either: the index is
    # the list.
    location /downloads/ {
        alias /usr/share/nginx/downloads/;
        autoindex off;
        types {
            application/msix     msix;
            application/json     json;
        }
        default_type application/octet-stream;
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
    }

    # Angular routes: anything that is not a file is the application.
    location / {
        include /etc/nginx/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/ /index.html;
    }
}

# Plain HTTP only to say where the real door is.
server {
    listen 80;
    server_name _;
    return 301 https://$host$request_uri;
}
